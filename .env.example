PSP_PROJECT_ROOT=C:/Users/arjun/Desktop/PSPreport

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/power_kg
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
RAW_BUCKET=psp-raw

# WBES isolated pipeline (all off by default; does not affect public PSP ingest)
WBES_ENABLED=false
WBES_ALLOW_LIVE_NETWORK=false
WBES_ALLOW_FIVE_MINUTE=false
WBES_WRITE_TIMESCALE=false
WBES_USERNAME=
WBES_PASSWORD=
WBES_SESSION_COOKIE=

# HTTP resilience policy
HTTP_MAX_ATTEMPTS=3
HTTP_BASE_DELAY_SECONDS=1.0
HTTP_MAX_DELAY_SECONDS=12.0
HTTP_JITTER_SECONDS=0.5
